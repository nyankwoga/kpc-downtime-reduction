# Copy this file to .env.local and point it at your running backend.
# Local dev default matches `uvicorn app:app --reload --port 8000`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# If you deploy the backend (see ../DEPLOY.md), point this at that URL instead, e.g.:
# NEXT_PUBLIC_API_URL=https://kpc-downtime-reduction.onrender.com
